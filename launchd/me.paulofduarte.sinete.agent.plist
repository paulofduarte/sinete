<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template installed by scripts/install-agent.sh (placeholders are filled in). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.paulofduarte.sinete.agent</string>
    <!-- Runs the wrapper, which captures the existing agent as upstream and
         republishes SSH_AUTH_SOCK before exec'ing `__BIN__ agent --socket`. -->
    <key>ProgramArguments</key>
    <array>
        <string>__WRAPPER__</string>
        <string>__BIN__</string>
        <string>__SOCKET__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Interactive so it runs in the Aqua session and is not throttled; the
         Secure Enclave Touch ID prompt can only be presented from there. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
